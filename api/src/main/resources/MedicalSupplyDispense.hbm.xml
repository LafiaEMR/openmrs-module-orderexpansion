<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="org.openmrs.module.orderexpansion.api.model.MedicalSupplyDispense" table="medical_supply_dispense">
        <id name="medicalSupplyDispenseId" column="medical_supply_dispense_id" type="java.lang.Integer">
            <generator class="native"/>
        </id>

        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id"/>
        <many-to-one name="encounter" class="org.openmrs.Encounter" column="encounter_id"/>
        <many-to-one name="medicalSupplyOrder" class="org.openmrs.module.orderexpansion.api.model.MedicalSupplyOrder" column="medical_supply_order_id"/>
        <many-to-one name="concept" class="org.openmrs.Concept" column="concept"/>
        <property name="dateDispensed" column="date_dispensed" type="java.util.Date"/>
        <many-to-one name="dispenser" class="org.openmrs.User" column="dispenser"/>
        <property name="quantity" column="quantity" type="java.lang.Double"/>
        <many-to-one name="quantityUnits" class="org.openmrs.Concept" column="quantity_units"/>
        
        <property name="status" column="status">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openmrs.module.orderexpansion.api.model.MedicalSupplyDispense$MedicalSupplyStatus</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        
        <many-to-one name="statusReason" class="org.openmrs.Concept" column="status_reason"/>
        <many-to-one name="location" class="org.openmrs.Location" column="location_id"/>
    </class>
</hibernate-mapping> 